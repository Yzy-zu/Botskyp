# Rellena localmente; chmod 600 .env. Nunca pegues secretos en el chat.
POSTGRES_PASSWORD=
DATABASE_URL=
EVOLUTION_URL=
EVOLUTION_APIKEY=
INSTANCE=
WEBHOOK_SECRET=
OWNER_JIDS=
BOT_JIDS=
LAB_CHAT_ID=
TRANSPORT=mock
STALE_SECONDS=120
TZ_DEFAULT=America/Mexico_City
CAPTURE_ENABLED=false
BIND_PORT=3000

# Pool separado por comas; prevalece sobre GEMINI_API_KEY (legacy).
GEMINI_API_KEYS=
GEMINI_API_KEY=
# true solo tras confirmar TODOS los proyectos de las keys sin facturación vinculada.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-3.5-flash-lite
WEB_SEARCH_PROVIDER=searxng

# Generar localmente: python3 -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=

# Dedicated redspi SSH key and pinned known_hosts mounted read-only into app only.
MINECRAFT_ENABLED=false

# Biblioteca: OAuth local dedicado con scope drive.readonly y root_folder_id.
LIBRARY_DRIVE_ENABLED=false
# Independent Drive file delivery OAuth, configured locally only (Phase 7).
DRIVE_ENABLED=false

# Router global; v1 permite rollback explícito, shadow solo observa.
ROUTER_MODE=v1_1
# Protecciones locales: 0 = sin límite local. No representan cuotas de Google.
LLM_LOCAL_USER_RPM=0
LLM_LOCAL_GLOBAL_RPM=0
LLM_LOCAL_DAILY_LIMIT=0
LLM_MAX_CONCURRENT_CALLS=4
# TPM local opcional: 0 = sin límite; reservas para accounting/TPM si se configura.
LLM_INPUT_TOKENS_PER_MINUTE=0
LLM_RESERVED_INPUT_TOKENS=32768
# Aliases: LLM_USER_RPM/GLOBAL_RPM/DAILY_LIMIT y GEMINI_* históricos.
# Precedencia: LLM_LOCAL_* > LLM_* > GEMINI_* > defaults.
