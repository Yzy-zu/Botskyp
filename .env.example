# Rellena localmente; chmod 600 .env. Nunca pegues secretos en el chat.
POSTGRES_PASSWORD=
DATABASE_URL=
EVOLUTION_URL=
EVOLUTION_APIKEY=
INSTANCE=
WEBHOOK_SECRET=
OWNER_JIDS=
BOT_JIDS=
LAB_CHAT_ID=
TRANSPORT=mock
STALE_SECONDS=120
TZ_DEFAULT=America/Mexico_City
CAPTURE_ENABLED=false
BIND_PORT=3000

GEMINI_API_KEY=
# true solo para clave de proyecto gratuito SIN facturación vinculada.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-3.5-flash-lite
WEB_SEARCH_PROVIDER=searxng

# Generar localmente: python3 -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=

# Dedicated redspi SSH key and pinned known_hosts mounted read-only into app only.
MINECRAFT_ENABLED=false

# Biblioteca: OAuth local dedicado con scope drive.readonly y root_folder_id.
LIBRARY_DRIVE_ENABLED=false
# Independent Drive file delivery OAuth, configured locally only (Phase 7).
DRIVE_ENABLED=false
