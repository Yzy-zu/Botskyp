{
  "name": "botsky",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && cp config/persona.md dist/config/persona.md",
    "start": "node dist/src/main.js",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:secrets": "python3 scripts/security-scan.py",
    "test": "vitest run",
    "eval:phase1": "tsx tests/phase1-vision-search.eval.ts",
    "migrate": "bash scripts/migrate.sh",
    "eval:phase2": "tsx tests/phase2-school.eval.ts",
    "observer:turn": "bash scripts/observer.sh turn",
    "observer:user": "bash scripts/observer.sh user",
    "observer:chat": "bash scripts/observer.sh chat",
    "observer:errors": "bash scripts/observer.sh errors",
    "observer:health": "bash scripts/observer.sh health",
    "qa:e2e": "tsx qa/e2e/runner.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
